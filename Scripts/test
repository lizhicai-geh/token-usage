#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p .build/tests
xcrun swiftc -swift-version 6 -module-cache-path .build/module-cache \
  Shared/AccountUsage.swift Shared/UsageSnapshot.swift App/AppServerClient.swift App/LocalUsage.swift Tests/UsageTests.swift -o .build/tests/usage-tests
.build/tests/usage-tests
